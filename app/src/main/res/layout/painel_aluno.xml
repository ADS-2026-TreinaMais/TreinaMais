<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/clout_painelAluno"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="16dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginRight="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PAINEL DO ALUNO"
                        android:textSize="13sp"
                        tools:ignore="HardcodedText" />

                    <TextView
                        android:id="@+id/tvAlunoNome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Aluno"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvAlunoEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="aluno@treinamais.com"
                        android:textColor="#888888"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvStatusSessaoAluno"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sessão ativa."
                        android:textColor="#4CAF50"
                        android:textSize="12sp"
                        tools:ignore="HardcodedText" />
                </LinearLayout>

                <!-- Botão Perfil -->

                <!-- Botão Sair -->

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2">

                    <androidx.constraintlayout.helper.widget.Flow
                        android:id="@+id/Flow"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        app:constraint_referenced_ids="btnRenovarSessaoAluno,btnVerificarStatusAluno,btnAlunoPerfil,btnAlunoLogout"
                        app:flow_horizontalGap="4dp"
                        app:flow_maxElementsWrap="2"
                        app:flow_wrapMode="aligned"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRenovarSessaoAluno"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="RENOVAR\nSESSÃO"
                        app:layout_constraintHorizontal_weight="1"
                        app:layout_constraintVertical_weight="1"
                        tools:ignore="HardcodedText"
                        tools:layout_editor_absoluteY="219dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnVerificarStatusAluno"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="TESTAR /ME"
                        app:layout_constraintHorizontal_weight="1"
                        app:layout_constraintVertical_weight="1"
                        tools:ignore="HardcodedText"
                        tools:layout_editor_absoluteX="7dp"
                        tools:layout_editor_absoluteY="219dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAlunoPerfil"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="PERFIL"
                        android:textStyle="bold"
                        app:cornerRadius="8dp"
                        app:layout_constraintHorizontal_weight="1"
                        app:layout_constraintVertical_weight="1"
                        app:strokeWidth="1dp"
                        tools:layout_editor_absoluteY="48dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAlunoLogout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="SAIR"
                        android:textStyle="bold"
                        app:cornerRadius="8dp"
                        app:layout_constraintHorizontal_weight="1"
                        app:layout_constraintVertical_weight="1"
                        app:strokeWidth="1dp"
                        tools:layout_editor_absoluteX="376dp"
                        tools:layout_editor_absoluteY="307dp" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="SEUS TREINOS"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

            <LinearLayout
                android:id="@+id/seusTreinosLY"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddProf"
                    style="@style/Widget.Material3.Button.IconButton.Filled"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:contentDescription="Escolher Professor"
                    app:cornerRadius="28dp"
                    app:icon="@android:drawable/ic_input_add"
                    app:iconGravity="textStart"
                    app:iconSize="48dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMeuProf"
                    style="@style/Widget.Material3.Button.IconButton.Filled"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:contentDescription="Meu Professor"
                    app:cornerRadius="28dp"
                    app:icon="@android:drawable/ic_menu_my_calendar"
                    app:iconGravity="textStart"
                    app:iconSize="48dp"
                    tools:ignore="HardcodedText" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_metrica"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvQtdTreinos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#4CAF50"
                        android:textSize="32sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Treinos Ativos"
                        android:textAlignment="center"
                        android:textColor="#CCCCCC"
                        android:textSize="12sp"
                        tools:ignore="HardcodedText" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExcluirProf"
                    style="@style/Widget.Material3.Button.IconButton.Filled"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:contentDescription="Remover Professor"
                    app:cornerRadius="28dp"
                    app:icon="@android:drawable/ic_menu_delete"
                    app:iconSize="48dp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="FICHA DE TREINO"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/tvSemTreinos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:padding="24dp"
                android:text="Nenhum treino atribuído pelo seu professor no momento."
                android:textSize="18sp"
                tools:ignore="HardcodedText" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerTreinosAluno"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
