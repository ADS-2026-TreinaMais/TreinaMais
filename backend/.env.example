# ==============================================================================
# Variáveis de Ambiente do Backend TreinaMais
# Copie este arquivo para .env na pasta backend/ (o .env não é versionado).
# Formato: CHAVE=valor (sem aspas, sem espaços ao redor do "=").
# ==============================================================================

# Porta do servidor Spring
PORT=8081

# Banco de Dados PostgreSQL (devem bater com infra/.env)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=treinamais
DB_USER=postgres
DB_PASSWORD=postgres
